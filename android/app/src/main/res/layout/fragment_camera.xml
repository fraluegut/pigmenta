<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- CameraX preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controls_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Overlay de sensores (sobre el preview) ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sensor_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:padding="8dp">

            <!-- GPS -->
            <TextView
                android:id="@+id/tv_gps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:text="📍 GPS: buscando…"
                android:textColor="#FFDD88"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingBottom="2dp" />

            <!-- Rumbo -->
            <TextView
                android:id="@+id/tv_azimuth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🧭 Rumbo: —"
                android:textColor="#FFDD88"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <!-- Inclinación -->
            <TextView
                android:id="@+id/tv_pitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="📐 Incl: —"
                android:textColor="#FFDD88"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <!-- Superficie inferida -->
            <TextView
                android:id="@+id/tv_surface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:text="🪨 Superficie: —"
                android:textColor="#AAD0FF"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingTop="2dp" />

        </GridLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Controls bar at the bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controls_bar"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@color/bg_surface"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Gallery button (left) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gallery"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Shutter button (center) — dinámico con animación -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_capture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_camera"
            app:backgroundTint="@color/accent_amber"
            app:fabSize="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Burst button (right of shutter) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_burst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_slideshow"
            android:contentDescription="@string/burst_btn_desc"
            app:backgroundTint="#2D2D2D"
            app:fabSize="mini"
            app:layout_constraintStart_toEndOf="@id/btn_capture"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Burst progress indicator -->
        <TextView
            android:id="@+id/tv_burst_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_amber"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btn_burst"
            app:layout_constraintStart_toStartOf="@id/btn_burst"
            app:layout_constraintEnd_toEndOf="@id/btn_burst" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
