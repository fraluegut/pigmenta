<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Fondo decorativo -->
    <View
        android:id="@+id/gradient_top"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/welcome_gradient_bg"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ScrollView con todo el contenido excepto el botón -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_enter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="16dp">

            <!-- Logo — imagen real del ciervo rupestre, recortada en círculo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_logo"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/CircleShape"
                app:strokeColor="@color/accent_amber"
                app:strokeWidth="2dp" />

            <!-- Nombre -->
            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent_amber"
                android:textSize="44sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="18dp" />

            <!-- Tagline -->
            <TextView
                android:id="@+id/tv_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:letterSpacing="0.15"
                android:textAllCaps="true"
                android:layout_marginTop="4dp" />

            <!-- Separador -->
            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:background="@color/accent_amber"
                android:alpha="0.5"
                android:layout_marginTop="18dp" />

            <!-- Descripción -->
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_description"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.55"
                android:gravity="center"
                android:paddingHorizontal="36dp"
                android:layout_marginTop="20dp" />

            <!-- Chips -->
            <LinearLayout
                android:id="@+id/chips_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="22dp">

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 filtros"
                    android:clickable="false"
                    app:chipBackgroundColor="@color/bg_surface"
                    android:textColor="@color/accent_amber"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.Material3.Chip.Suggestion" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAW · Burst"
                    android:clickable="false"
                    app:chipBackgroundColor="@color/bg_surface"
                    android:textColor="@color/accent_amber"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.Material3.Chip.Suggestion" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:clickable="false"
                    app:chipBackgroundColor="@color/bg_surface"
                    android:textColor="@color/accent_amber"
                    style="@style/Widget.Material3.Chip.Suggestion" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Botón anclado al fondo, SIEMPRE visible -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_enter"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="@string/welcome_btn_enter"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/accent_amber"
        app:cornerRadius="28dp"
        android:textColor="@color/bg_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
