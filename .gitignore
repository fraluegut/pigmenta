**/generated/
gradle/wrapper/gradle-wrapper.jar

# Android
local.properties
*.properties.local
captures/
*.apk
*.aab
*.keystore
*.jks
keystore.properties
release-signing.properties

# IDE
.idea/
*.iml
*.iws
*.ipr
*.vscode/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.orig

# Logs
*.log
hs_err_pid*
