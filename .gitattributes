# Normalizar finales de línea al hacer commit
* text=auto

# Forzar LF en archivos de texto del proyecto Android
*.kt        text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.kts       text eol=lf
*.properties text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.cpp       text eol=lf
*.h         text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf

# El script gradlew debe tener LF (se ejecuta en Linux/Mac/CI)
gradlew     text eol=lf

# Binarios — sin conversión
*.jar       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.so        binary
*.apk       binary
*.aab       binary
*.keystore  binary
*.jks       binary
